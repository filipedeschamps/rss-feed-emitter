{
  "name": "rss-feed-emitter",
  "version": "3.0.0",
  "description": "Super RSS News Feed aggregator written in Node.js",
  "type": "module",
  "main": "./src/index.cjs",
  "module": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./src/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "directories": {
    "test": "test/**/*.spec.js"
  },
  "scripts": {
    "test": "c8 mocha",
    "test:unit": "mocha test/unit",
    "test:integration": "mocha test/integration",
    "coverage": "c8 report --reporter=lcov",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run build:types",
    "build:types": "node -e \"fs.rmSync('types', { recursive: true, force: true })\" && tsc -p tsconfig.declaration.json",
    "test:legacy": "mocha test/legacy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filipedeschamps/rss-feed-emitter.git"
  },
  "keywords": [
    "rss",
    "feed",
    "emitter",
    "aggregator",
    "news",
    "atom"
  ],
  "author": "Filipe Deschamps",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/filipedeschamps/rss-feed-emitter/issues"
  },
  "homepage": "https://github.com/filipedeschamps/rss-feed-emitter#readme",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/feedparser": "2.3.0",
    "@types/node": "22.20.5",
    "c8": "12.0.0",
    "chai": "6.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-jsdoc": "65.4.0",
    "globals": "17.13.0",
    "mocha": "12.0.3",
    "nock": "15.0.4",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "feedparser": "2.6.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "src",
    "types"
  ]
}
