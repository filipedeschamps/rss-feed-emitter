{
  "include": [
    "src/**/*.js",
    "src/**/*.cjs"
  ],
  "compilerOptions": {
    "outDir": "./types",
    "rootDir": "./src",
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowJs": true,
    "checkJs": false,
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "useDefineForClassFields": true,
    "skipLibCheck": true
  }
}
